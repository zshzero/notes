      "text": "Applicability\n\n- Use the Flyweight pattern only when your program must support a huge \nnumber of objects which barely fit into available RAM.",
      "fontSize": 29.79547481958467,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Applicability\n\n- Use the Flyweight pattern only when your program must support a huge \nnumber of objects which barely fit into available RAM.",
      "autoResize": true,
      "lineHeight": 1.25
    },
