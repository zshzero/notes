      "x": -26555.594349080442,
      "y": -1599.4119317484374,
      "width": 1170.399658203125,
      "height": 1715,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Gkzuz",
