    {
      "id": "Ucg8oVv6wU-NmJrRe4-_R",
      "type": "text",
      "x": -11788.60948601394,
      "y": -8790.209707299648,
      "width": 1460.433349609375,
      "height": 297.9547481958467,
      "angle": 0,
