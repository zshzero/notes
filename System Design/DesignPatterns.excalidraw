    {
      "id": "xr5_FIGliU9OfCiqgcAtx",
      "type": "text",
      "x": -1497.7766322425464,
      "y": -2718.802127605176,
      "width": 1460.433349609375,
      "height": 297.9547481958467,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
