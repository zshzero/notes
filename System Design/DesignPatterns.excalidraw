      "containerId": null,
      "originalText": "static void Main(string[] args)\n{\n    // The client code.\n    var context = new Context(new ConcreteStateA());\n    context.Request1();\n    context.Request2();\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
