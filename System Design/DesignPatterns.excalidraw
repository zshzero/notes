    {
      "id": "J5VfDrjkwJwuSoZYp3BmT",
      "type": "text",
      "x": -1054.71044921875,
      "y": 335.963134765625,
      "width": 847.0594482421875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
